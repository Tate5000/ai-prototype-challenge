# Vercel AI Gateway — on Vercel this authenticates automatically (OIDC), no key needed.
# For local dev, get a key from the Vercel dashboard: Project Settings -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5

# Fallback for local dev before a Vercel project/Gateway key exists: calls Anthropic directly.
# Only used when AI_GATEWAY_API_KEY is not set.
ANTHROPIC_API_KEY=

# Neon (Postgres) — from your Neon project's connection string
DATABASE_URL=

# Neon Auth (managed Better Auth) — enable it in the Neon console: your project -> Auth tab ->
# Enable Auth. NEON_AUTH_BASE_URL is the "Auth URL" shown there. NEON_AUTH_COOKIE_SECRET is a
# locally-generated secret (32+ chars, e.g. `openssl rand -base64 32`) used to sign session
# cookies — it does not come from the dashboard. Required: the chat API rejects unauthenticated
# requests and tags every audit log entry with the signed-in user. Sign-in is magic-link only
# (see NeonAuthUIProvider in src/app/layout.tsx); the default shared sender works out of the
# box — to send from your own domain via Resend, configure it under Auth -> Authentication ->
# Configure email provider in the Neon console (dashboard-only, no app code needed).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Trigger.dev — project ref is proj_rgkakpezcqkpfbapmkks (set in trigger.config.ts);
# TRIGGER_SECRET_KEY comes from the project's dev environment in the Trigger.dev dashboard
TRIGGER_SECRET_KEY=
