# Vercel AI Gateway — on Vercel this authenticates automatically (OIDC), no key needed.
# For local dev, get a key from the Vercel dashboard: Project Settings -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5

# Fallback for local dev before a Vercel project/Gateway key exists: calls Anthropic directly.
# Only used when AI_GATEWAY_API_KEY is not set.
ANTHROPIC_API_KEY=

# Neon (Postgres) — from your Neon project's connection string
DATABASE_URL=

# Trigger.dev — project ref is proj_rgkakpezcqkpfbapmkks (set in trigger.config.ts);
# TRIGGER_SECRET_KEY comes from the project's dev environment in the Trigger.dev dashboard
TRIGGER_SECRET_KEY=
